{
  "name": "schedule-music-app",
  "version": "1.1.0",
  "description": "요일·시간대별로 정해진 음악을 자동 재생하는 Windows 데스크톱 앱",
  "author": "SUK-HO KIM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "icon": "electron scripts/make-icon.js .",
    "release": "electron-builder && node scripts/copy-release.js"
  },
  "build": {
    "appId": "com.example.schedulemusic",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!releases/**",
      "!docs/**",
      "!scripts/**",
      "!build/**",
      "!*.md",
      "!설치안내.txt",
      "!.gitignore"
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "electron-reload": "^2.0.0-alpha.1"
  }
}
